// CrowdSmart – Map Screen
import 'dart:async';
import 'package:flutter/material.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import '../models/models.dart';
import '../config/api_config.dart';
import '../services/location_service.dart';
import '../services/traffic_service.dart';
import '../services/weather_service.dart';
import 'route_suggestion_screen.dart';
import 'destination_detail_screen.dart';

class MapScreen extends StatefulWidget {
  const MapScreen({super.key});

  @override
  State<MapScreen> createState() => _MapScreenState();
}

class _MapScreenState extends State<MapScreen> {
  // ── Map ──────────────────────────────────────────────────────────────────
  GoogleMapController? _mapController;
  final Set<Marker> _markers = {};
  MapType _mapType = MapType.normal;
  bool _showMapTypeMenu = false;
  Set<Polyline> _routePolylines = {};
  TouristLocation? _selectedLocation;

  // ── Traffic ───────────────────────────────────────────────────────────────
  List<TrafficSegment> _trafficSegments = [];
  final TrafficService _trafficService = TrafficService();
  StreamSubscription<List<TrafficSegment>>? _trafficSub;

  // ── Weather ───────────────────────────────────────────────────────────────
  final WeatherService _weatherService = WeatherService();
  StreamSubscription<WeatherData>? _weatherSub;
  StreamSubscription<List<HourlyWeather>>? _hourlyForecastSub;
  WeatherData? _currentWeather;
  List<HourlyWeather> _hourlyForecast = [];
  bool _showWeatherDetails = false;

  // ── Location ──────────────────────────────────────────────────────────────
  final LocationService _locationService = LocationService();
  StreamSubscription<LatLng>? _locationSub;
  StreamSubscription<LocationStatus>? _locationStatusSub;
  LatLng? _userPosition;
  double? _userHeading;
  LocationStatus _locationStatus = LocationStatus.idle;
  bool _followingUser = false;

  static const _baguioCenter = CameraPosition(
    target: LatLng(ApiConfig.baguioLat, ApiConfig.baguioLng),
    zoom: ApiConfig.defaultZoom,
  );

  final bool _hasApiKey =
      ApiConfig.googleMapsApiKey != 'YOUR_GOOGLE_MAPS_API_KEY_HERE' &&
          ApiConfig.googleMapsApiKey.isNotEmpty;

  // ── Lifecycle ───────────────────────────────────────��─────────────────────
  @override
  void initState() {
    super.initState();
    _buildMarkers();
    _trafficService.start();
    _trafficSub = _trafficService.trafficStream.listen((segs) {
      if (!mounted) return;
      setState(() => _trafficSegments = segs);
    });
    _weatherService.start();
    _weatherSub = _weatherService.weatherStream.listen((weather) {
      if (!mounted) return;
      setState(() => _currentWeather = weather);
    });
    _hourlyForecastSub = _weatherService.hourlyForecastStream.listen((forecast) {
      if (!mounted) return;
      setState(() => _hourlyForecast = forecast);
    });
    _locationSub = _locationService.positionStream.listen((pos) {
      if (!mounted) return;
      setState(() {
        _userPosition = pos;
        _userHeading = _locationService.currentHeading;
      });
      _updateUserMarker(pos);
      if (_followingUser && _mapController != null) {
        _mapController!.animateCamera(CameraUpdate.newLatLng(pos));
      }
    });
    _locationStatusSub = _locationService.statusStream.listen((s) {
      if (!mounted) return;
      setState(() => _locationStatus = s);
      if (s == LocationStatus.denied) _showLocationDeniedSnackbar();
    });
  }

  @override
  void dispose() {
    _trafficSub?.cancel();
    _trafficService.dispose();
    _weatherSub?.cancel();
    _hourlyForecastSub?.cancel();
    _weatherService.dispose();
    _locationSub?.cancel();
    _locationStatusSub?.cancel();
    _locationService.dispose();
    _mapController?.dispose();
    super.dispose();
  }

  // ── Markers ───────────────────────────────────────────────────────────────
  void _buildMarkers() {
    for (final loc in AppData.locations) {
      _markers.add(Marker(
        markerId: MarkerId(loc.id),
        position: loc.position,
        icon: BitmapDescriptor.defaultMarkerWithHue(
          loc.crowdStatus == 'Low'
              ? BitmapDescriptor.hueGreen
              : loc.crowdStatus == 'Moderate'
                  ? BitmapDescriptor.hueOrange
                  : BitmapDescriptor.hueRed,
        ),
        onTap: () => _onDestinationTapped(loc),
        infoWindow: InfoWindow(
          title: '${loc.emoji} ${loc.name}',
          snippet: '${loc.crowdStatus} Crowd · ${loc.travelTime} away',
          onTap: () => _navigateToDetail(loc),
        ),
      ));
    }
  }

  void _updateUserMarker(LatLng pos) {
    final updated =
        Set<Marker>.from(_markers.where((m) => m.markerId.value != 'user_location'));
    updated.add(Marker(
      markerId: const MarkerId('user_location'),
      position: pos,
      icon: BitmapDescriptor.defaultMarkerWithHue(BitmapDescriptor.hueAzure),
      infoWindow: const InfoWindow(title: '📍 You are here'),
      anchor: const Offset(0.5, 0.5),
    ));
    if (mounted) setState(() => _markers..clear()..addAll(updated));
  }

  Set<Marker> get _visibleMarkers {
    if (_selectedLocation == null) return _markers;
    return _markers
        .where((m) =>
            m.markerId.value == _selectedLocation!.id ||
            m.markerId.value == 'user_location')
        .toSet();
  }

  // ── Location tracking ─────────────────────────────────────────────────────
  Future<void> _toggleLocationTracking() async {
    if (_locationService.isTracking) {
      _locationService.stopTracking();
      setState(() {
        _followingUser = false;
        _locationStatus = LocationStatus.idle;
      });
    } else {
      await _locationService.startTracking();
      if (_locationService.isTracking) {
        setState(() => _followingUser = true);
        _goToMyLocation();
      }
    }
  }

  void _goToMyLocation() {
    final pos = _userPosition ?? _locationService.currentPosition;
    if (pos != null && _mapController != null) {
      _mapController!.animateCamera(CameraUpdate.newCameraPosition(
        CameraPosition(
          target: pos,
          zoom: 17.0,
          bearing: _userHeading ?? 0,
          tilt: 30,
        ),
      ));
      setState(() => _followingUser = true);
    }
  }

  void _showLocationDeniedSnackbar() {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: const Row(children: [
        Icon(Icons.location_off, color: Colors.white, size: 18),
        SizedBox(width: 8),
        Expanded(
            child: Text('Location permission denied.',
                style: TextStyle(fontSize: 13))),
      ]),
      backgroundColor: const Color(0xFFE53935),
      behavior: SnackBarBehavior.floating,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
    ));
  }

  // ── Destination tap → fetch single route ──────────────────────────────────
  void _onDestinationTapped(TouristLocation loc) {
    _mapController?.animateCamera(CameraUpdate.newCameraPosition(
        CameraPosition(target: loc.position, zoom: ApiConfig.detailZoom)));
    setState(() {
      _selectedLocation = loc;
      _routePolylines = {};
    });
  }



  void _navigateToDetail(TouristLocation loc) {
    Navigator.push(context,
        MaterialPageRoute(builder: (_) => DestinationDetailScreen(location: loc)));
  }

