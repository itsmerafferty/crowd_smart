                  children: [
                    Text(
                      'Weather & Driving',
                      style: const TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFF2D3748),
                      ),
                    ),
                    Text(
                      'Baguio City',
                      style: const TextStyle(
                        fontSize: 10,
                        color: Color(0xFF9CA3AF),
